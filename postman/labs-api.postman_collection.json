{
  "info": {
    "name": "Script Labs API Testing",
    "description": "Final assignment API testing untuk https://labs.hendri.me (API: https://api-script-labs.hendri.me).\nKredensial diambil dari environment (lokal) atau --env-var (CI), tidak di-hardcode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ===== Test level COLLECTION: otomatis jalan di SETIAP request =====",
          "// Batas response time bisa diubah lewat variable max_response_time",
          "const maxTime = Number(pm.variables.get(\"max_response_time\") || 3000);",
          "pm.test(\"Response time < \" + maxTime + \" ms\", () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(maxTime);",
          "});",
          "// Semua response API ini berformat JSON",
          "pm.test(\"Content-Type berformat JSON\", () => {",
          "    pm.response.to.have.header(\"Content-Type\");",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api-script-labs.hendri.me"
    },
    {
      "key": "max_response_time",
      "value": "3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "lab_id",
      "value": ""
    },
    {
      "key": "lab_title",
      "value": ""
    },
    {
      "key": "lab_description",
      "value": ""
    },
    {
      "key": "lab_title_updated",
      "value": ""
    },
    {
      "key": "lab_description_updated",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Auth",
      "description": "Login. Folder ini TANPA auth karena token belum ada.",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Login - Valid (Standard User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Status 200 = login berhasil",
                  "pm.test(\"Status code 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "// Cek struktur body: success, data.token, data.user",
                  "pm.test(\"Body: success = true & message benar\", () => {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.message).to.eql(\"Login successful\");",
                  "});",
                  "pm.test(\"Body: token berupa string (JWT) dan tidak kosong\", () => {",
                  "    pm.expect(json.data.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(json.data.token.split(\".\")).to.have.lengthOf(3); // JWT = 3 bagian",
                  "});",
                  "pm.test(\"Body: email user sama dengan email yang dikirim\", () => {",
                  "    pm.expect(json.data.user.email).to.eql(pm.variables.get(\"login_email\"));",
                  "    pm.expect(json.data.user.role).to.eql(\"user\");",
                  "    pm.expect(json.data.user.status).to.eql(\"active\");",
                  "});",
                  "",
                  "// SIMPAN TOKEN ke collection variable -> dipakai otomatis oleh",
                  "// Authorization: Bearer {{token}} di level collection",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set(\"token\", json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login - Valid (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: success = true & token ada\", () => {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "// Poin penting akun admin: role harus \"admin\"",
                  "pm.test(\"Body: role = admin\", () => {",
                  "    pm.expect(json.data.user.email).to.eql(pm.variables.get(\"admin_email\"));",
                  "    pm.expect(json.data.user.role).to.eql(\"admin\");",
                  "});",
                  "// Token admin TIDAK disimpan -> semua CRUD tetap memakai token standard user"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
