    {
      "name": "04 Data Driven",
      "description": "Jalankan dengan data/labs-data.csv (Collection Runner atau newman -d).",
      "item": [
        {
          "name": "Create Lab - Data Driven (CSV)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ambil data baris CSV yang sedang berjalan (pm.iterationData).",
                  "// Kalau request dijalankan TANPA CSV (klik Send biasa), pakai data default",
                  "// supaya tetap bisa jalan dan lulus.",
                  "const fromCsv = pm.iterationData.has(\"scenario\");",
                  "const title = fromCsv ? pm.iterationData.get(\"title\") : \"Default Lab Tanpa CSV\";",
                  "const description = fromCsv ? pm.iterationData.get(\"description\") : \"Default description\";",
                  "const expected = fromCsv ? pm.iterationData.get(\"expected_status\") : 201;",
                  "",
                  "// Body dibuat dengan JSON.stringify supaya karakter spesial (\" \\ dll.)",
                  "// tetap menghasilkan JSON yang valid",
                  "pm.variables.set(\"dd_body\", JSON.stringify({ title: title, description: description }));",
                  "pm.variables.set(\"dd_title\", title);",
                  "pm.variables.set(\"dd_description\", description);",
                  "pm.variables.set(\"dd_expected\", Number(expected));",
                  "pm.variables.set(\"dd_scenario\", fromCsv ? pm.iterationData.get(\"scenario\") : \"default_valid\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const scenario = pm.variables.get(\"dd_scenario\");",
                  "const expected = Number(pm.variables.get(\"dd_expected\"));",
                  "const json = pm.response.json();",
                  "",
                  "// Assertion DINAMIS: status yang diharapkan diambil dari kolom expected_status CSV",
                  "pm.test(\"[\" + scenario + \"] Status code = \" + expected, () => {",
                  "    pm.response.to.have.status(expected);",
                  "});",
                  "",
                  "if (expected === 201) {",
                  "    // Skenario valid/edge yang diterima: data tersimpan sesuai input",
                  "    pm.test(\"[\" + scenario + \"] Body: data tersimpan sesuai input\", () => {",
                  "        pm.expect(json.success).to.eql(true);",
                  "        pm.expect(json.data.id).to.be.a(\"number\");",
                  "        pm.expect(json.data.title).to.eql(pm.variables.get(\"dd_title\"));",
                  "        pm.expect(json.data.description).to.eql(pm.variables.get(\"dd_description\"));",
                  "    });",
                  "} else {",
                  "    // Skenario invalid: harus ditolak dengan pesan error validasi",
                  "    pm.test(\"[\" + scenario + \"] Body: success = false & ada pesan error\", () => {",
                  "        pm.expect(json.success).to.eql(false);",
                  "        pm.expect(json.error.message).to.be.a(\"string\").and.include(\"Validation Error\");",
                  "    });",
                  "}",
                  "",
                  "// Bersihkan data test supaya tidak menumpuk di akun.",
                  "// Pakai status AKTUAL (bukan expected) supaya tetap terhapus walau test-nya gagal.",
                  "if (pm.response.code === 201 && json.data && json.data.id) {",
                  "    pm.sendRequest({",
                  "        url: pm.variables.get(\"base_url\") + \"/api/labs/\" + json.data.id,",
                  "        method: \"DELETE\",",
                  "        header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"token\") }",
                  "    }, (err, res) => {",
                  "        pm.test(\"[\" + scenario + \"] Cleanup: data test berhasil dihapus\", () => {",
                  "            pm.expect(err).to.eql(null);",
                  "            pm.expect(res.code).to.eql(200);",
                  "        });",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/labs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "labs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{dd_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    }
  ]
}
