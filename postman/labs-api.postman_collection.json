        {
          "name": "Login - Negative (Wrong Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Password salah -> 401 Unauthorized",
                  "pm.test(\"Status code 401\", () => pm.response.to.have.status(401));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Body: success = false & code AUTH_FAILED\", () => {",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.error.code).to.eql(\"AUTH_FAILED\");",
                  "    pm.expect(json.error.message).to.eql(\"Invalid email or password\");",
                  "});",
                  "pm.test(\"Body: tidak ada token\", () => {",
                  "    pm.expect(json).to.not.have.property(\"data\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
